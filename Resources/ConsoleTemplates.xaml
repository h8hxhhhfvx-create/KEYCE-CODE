<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Une ligne de console : la couleur dépend du type (erreur, info, saisie...) -->
    <DataTemplate x:Key="ConsoleLineTemplate">
        <TextBlock x:Name="Line"
                   Text="{Binding Text}"
                   MinHeight="16"
                   TextWrapping="Wrap"
                   FontFamily="Cascadia Mono, Consolas"
                   FontSize="13"
                   Foreground="#D4D4D4"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="StdErr">
                <Setter TargetName="Line" Property="Foreground" Value="#F48771"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter TargetName="Line" Property="Foreground" Value="#F48771"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Info">
                <Setter TargetName="Line" Property="Foreground" Value="#569CD6"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter TargetName="Line" Property="Foreground" Value="#6A9955"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Input">
                <Setter TargetName="Line" Property="Foreground" Value="#DCDCAA"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Pas de sélection/surbrillance sur les lignes -->
    <Style x:Key="ConsoleItemStyle" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter Margin="6,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConsoleButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#3C3C3C"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#505050"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
