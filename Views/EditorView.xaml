<UserControl x:Class="KeyceCode.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="#1E2128">
    <Grid Background="#1E2128">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="96" />
        </Grid.ColumnDefinitions>
        <avalonedit:TextEditor x:Name="Editor"
                               Grid.Column="0"
                               Background="#1E2128"
                               Foreground="#DCDCDC"
                               FontFamily="Cascadia Mono"
                               FontSize="13"
                               Padding="8,4"
                               ShowLineNumbers="True"
                               LineNumbersForeground="#7D8491"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               WordWrap="False"
                               IsReadOnly="False" />
        <Border Grid.Column="1" Background="#181A20" BorderBrush="#30343D" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="MiniMapScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Hidden"
                          Background="#181A20"
                          MouseDown="OnMiniMapMouseDown">
                <TextBlock x:Name="MiniMapText"
                           Margin="4,6"
                           Foreground="#737B8C"
                           FontFamily="Cascadia Mono"
                           FontSize="4"
                           LineHeight="6"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
