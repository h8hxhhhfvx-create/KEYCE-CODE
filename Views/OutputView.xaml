<UserControl x:Class="KeyceCode.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KeyceCode;component/Resources/ConsoleTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils : Compiler / Exécuter / Arrêter / Effacer -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6">
            <Button Content="🔨 Compiler" Command="{Binding CompileCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <Button Content="▶ Exécuter" Command="{Binding RunCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <Button Content="■ Arrêter" Command="{Binding StopCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <Button Content="Effacer" Command="{Binding ClearCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <TextBlock Text="{Binding Status}" Foreground="#9CDCFE" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Console : sortie du compilateur et du programme -->
        <ListBox x:Name="LinesList"
                 Grid.Row="1"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 ItemsSource="{Binding Log.Lines}"
                 ItemTemplate="{StaticResource ConsoleLineTemplate}"
                 ItemContainerStyle="{StaticResource ConsoleItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <!-- Problèmes : filtre, gravité, tri et double-clic pour aller à la ligne -->
        <Grid Grid.Row="2" MaxHeight="190" Background="#252526">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="6,5,6,3">
                <TextBlock Text="Problèmes" Foreground="#DCDCAA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="190" Text="{Binding DiagnosticFilter, UpdateSourceTrigger=PropertyChanged}"
                         Background="#3C3C3C" Foreground="White" CaretBrush="White"
                         BorderThickness="0" Padding="4" ToolTip="Filtrer par fichier, code ou message"/>
                <ComboBox Width="112" Margin="6,0,0,0" ItemsSource="{Binding DiagnosticSeverityOptions}"
                          SelectedItem="{Binding DiagnosticSeverity}" ToolTip="Filtrer par gravité"/>
                <ComboBox Width="102" Margin="6,0,0,0" ItemsSource="{Binding DiagnosticSortOptions}"
                          SelectedItem="{Binding DiagnosticSort}" ToolTip="Trier les problèmes"/>
                <TextBlock Text="{Binding VisibleDiagnosticCount, StringFormat=Total : {0}}" Foreground="#9CDCFE"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
            <ListBox x:Name="DiagList" Grid.Row="1" Background="#252526" BorderThickness="0"
                     ItemsSource="{Binding DiagnosticsView}" SelectedItem="{Binding SelectedDiagnostic}">
                <ListBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenDiagnosticCommand}"
                                  CommandParameter="{Binding SelectedDiagnostic}"/>
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" Foreground="#F48771"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Saisie clavier pour les programmes qui lisent la console (Console.ReadLine...) -->
        <DockPanel Grid.Row="3" Margin="6">
            <TextBlock Text="Saisie :" DockPanel.Dock="Left" Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy}"
                     Background="#3C3C3C"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0"
                     Padding="4"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendInputCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
