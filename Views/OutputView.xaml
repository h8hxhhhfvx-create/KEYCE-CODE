<UserControl x:Class="KeyceCode.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/KeyceCode;component/Resources/ConsoleTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils : Compiler / Exécuter / Arrêter / Effacer -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6">
            <Button Content="🔨 Compiler" Command="{Binding CompileCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <Button Content="▶ Exécuter" Command="{Binding RunCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <Button Content="■ Arrêter" Command="{Binding StopCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <Button Content="Effacer" Command="{Binding ClearCommand}" Style="{StaticResource ConsoleButtonStyle}"/>
            <TextBlock Text="{Binding Status}" Foreground="#9CDCFE" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Console : sortie du compilateur et du programme -->
        <ListBox x:Name="LinesList"
                 Grid.Row="1"
                 Background="#1E1E1E"
                 BorderThickness="0"
                 ItemsSource="{Binding Log.Lines}"
                 ItemTemplate="{StaticResource ConsoleLineTemplate}"
                 ItemContainerStyle="{StaticResource ConsoleItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <!-- Liste des erreurs / avertissements (double-clic = aller à la ligne) -->
        <ListBox x:Name="DiagList"
                 Grid.Row="2"
                 MaxHeight="140"
                 Background="#252526"
                 BorderThickness="0,1,0,0"
                 BorderBrush="#3C3C3C"
                 ItemsSource="{Binding Diagnostics}"
                 SelectedItem="{Binding SelectedDiagnostic}">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Diagnostics.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding OpenDiagnosticCommand}"
                              CommandParameter="{Binding SelectedDiagnostic}"/>
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}"
                               Foreground="#F48771"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Saisie clavier pour les programmes qui lisent la console (Console.ReadLine...) -->
        <DockPanel Grid.Row="3" Margin="6">
            <TextBlock Text="Saisie :" DockPanel.Dock="Left" Foreground="#9CDCFE" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy}"
                     Background="#3C3C3C"
                     Foreground="White"
                     CaretBrush="White"
                     BorderThickness="0"
                     Padding="4"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendInputCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
